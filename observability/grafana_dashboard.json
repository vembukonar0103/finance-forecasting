{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Model Inference Latency (p95 / p50)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(inference_latency_seconds_bucket[5m])) by (le, model))",
          "legendFormat": "{{model}} (p95)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(inference_latency_seconds_bucket[5m])) by (le, model))",
          "legendFormat": "{{model}} (p50)",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "API Request Throughput (req/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(inference_requests_total[1m])) by (endpoint, status)",
          "legendFormat": "{{endpoint}} - {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "title": "Cache Hit Ratio (%)",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(rate(cache_access_total{hit=\"true\"}[5m])) / clamp_min(sum(rate(cache_access_total[5m])), 0.001) * 100",
          "legendFormat": "Hit Rate %",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "title": "Current Screener Matches",
      "type": "stat",
      "targets": [
        {
          "expr": "screener_match_count",
          "legendFormat": "Active Matches",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "title": "5xx Server Error Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(inference_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "Errors / sec",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["finance-forecasting", "timesfm", "kronos"],
